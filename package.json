{
  "name": "kozou-desktop",
  "version": "0.4.0-alpha.1",
  "private": true,
  "description": "kozou Desktop — Semantic Map (validation-first MVP): a read-only, cross-database visual surface for the semantic model kozou compiles from your PostgreSQL schema.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "svelte-check --tsconfig ./tsconfig.web.json --fail-on-warnings",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "playwright test",
    "check:treeshake": "node scripts/check-treeshake.mjs",
    "check:egress": "node scripts/check-egress-static.mjs",
    "dist": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-vite build && pnpm check:treeshake && pnpm check:egress && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@kozou/api": "^1.21.0",
    "@kozou/core": "^1.21.0",
    "@kozou/introspect": "^1.21.0",
    "@kozou/mcp": "^1.21.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.1.0",
    "elkjs": "^0.11.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "kozou": "1.21.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
